# Required: paste your Discord webhook URL here
# Create one at: Channel Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# Optional: Best Buy developer API key for more reliable Best Buy results
# Get one free at: https://developer.bestbuy.com/
BESTBUY_API_KEY=

# Optional: Your zip code to enable Costco IN-STORE monitoring
# Without this, only Costco online availability is monitored
COSTCO_ZIP_CODE=

# Optional: Override poll intervals (milliseconds)
MONITOR_INTERVAL_MS=300000
DISCOVERY_INTERVAL_MS=86400000
